---------------------------------------------------
-- DISCO
---------------------------------------------------

local discoActive = false

discoBtn.MouseButton1Click:Connect(function()
	if discoActive then return end
	discoActive = true

	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")

	local balls = {}
	activeBalls = balls

	for i=1,10 do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(2,2,2)
		p.Anchored = true
		p.Material = Enum.Material.Neon
		p.Parent = workspace

		local l = Instance.new("PointLight",p)
		l.Brightness = 3

		table.insert(balls,p)
	end

	local t = tick()
	local conn

	conn = RunService.RenderStepped:Connect(function()
		local e = tick()-t
		if e>3 then
			conn:Disconnect()
			for _,v in pairs(balls) do v:Destroy() end
			activeBalls = {}
			discoActive = false
			return
		end

		for i,v in ipairs(balls) do
			local a = e*4+i
			v.Position = hrp.Position + Vector3.new(math.cos(a)*8,2+math.sin(e*5+i),math.sin(a)*8)
			v.Color = Color3.fromHSV((e+i)/10%1,1,1)
		end
	end)
end)

---------------------------------------------------
-- RAINBOW SCREEN
---------------------------------------------------

local function updateRainbowUI()
	if rainbowOn then
		rainbowBtn.Text = texts[lang].stop
		rainbowBtn.BackgroundColor3 = Color3.fromRGB(255,60,60)
	else
		rainbowBtn.Text = texts[lang].rainbow
		rainbowBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
	end
end

rainbowBtn.MouseButton1Click:Connect(function()
	rainbowOn = not rainbowOn
	updateRainbowUI()

	if rainbowOn then
		task.spawn(function()
			local h=0
			while rainbowOn do
				h=(h+0.01)%1
				local c=Color3.fromHSV(h,1,1)
				Lighting.Ambient=c
				Lighting.OutdoorAmbient=c
				task.wait(0.01)
			end
		end)
	else
		Lighting.Ambient = originalAmbient
		Lighting.OutdoorAmbient = originalOutdoor
	end
end)

updateRainbowUI()

